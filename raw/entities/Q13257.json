xt", "type": "string"}, "datatype": "url"}, "type": "statement", "id": "Q13257$8CA5B92A-1646-4436-B0FC-6AA79EF5076C", "rank": "normal"}], "P22": [{"mainsnak": {"snaktype": "value", "property": "P22", "hash": "e27b4f098684c31b4e525045be8321811b6fc3b3", "datavalue": {"value": {"entity-type": "item", "numeric-id": 732, "id": "Q732"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q13257$FB5FA4CD-A094-487C-86D3-4812F92734F0", "rank": "normal"}], "P23": [{"mainsnak": {"snaktype": "value", "property": "P23", "hash": "0eda2d83b65da07146116314087628a7c10ed67d", "datavalue": {"value": {"entity-type": "item", "numeric-id": 732, "id": "Q732"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q13257$FFC1CC79-5DB4-48F0-BF4B-F23A840F1C32", "rank": "normal"}], "P21": [{"mainsnak": {"snaktype": "value", "property": "P21", "hash": "033bba94d2ee2ccb943991111d5eb28daf1061d7", "datavalue": {"value": {"entity-type": "item", "numeric-id": 101, "id": "Q101"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q13257$BA7E796E-C8C7-438D-B1E0-0CDFB9A2352F", "rank": "normal"}], "P19": [{"mainsnak": {"snaktype": "value", "property": "P19", "hash": "24959976dde9e88b1b2ff40e31e79f81dd0e15c5", "datavalue": {"value": "Not too far from us. He lived closer to LaGuardia Airport than we did. But and you know to the day he died he would never call me anything but Mrs. Hinton. I used to say \"Pop, it's embarrassing, you call all the other wives by their first names,\" and one day he said to me and I said \"why ... it's embarrassing to me that you always say 'Mrs. Hinton.'\" And he says, with that gravel voice, he said...", "type": "string"}, "datatype": "string"}, "type": "statement", "id": "Q13257$EC1EBF4F-2B4C-4D9C-8C75-FE97E579E920", "rank": "normal"}]}}