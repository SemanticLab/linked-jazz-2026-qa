m", "numeric-id": 1386, "id": "Q1386"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q12089$C7386D14-47FF-41AA-9405-6973012C4EE5", "rank": "normal"}], "P23": [{"mainsnak": {"snaktype": "value", "property": "P23", "hash": "c7e1e1023400f659b211fe58b5adf4a1a7e6634e", "datavalue": {"value": {"entity-type": "item", "numeric-id": 1386, "id": "Q1386"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q12089$9FECD9C9-EBBA-419B-8D58-ECA77709F7CE", "rank": "normal"}], "P19": [{"mainsnak": {"snaktype": "value", "property": "P19", "hash": "63f6d46acc5d11971929266322884d2b03155117", "datavalue": {"value": "No. That was one of the disadvantages. I started to travel with my own band when I became a jazz singer. When I recorded the first album I made with Max and Kenny Dorham and Sonny Rollins and Wynton Kelly and Paul Chambers, I knew I was never going back to doing what I had been doing. I was going to work with these kind of musicians.", "type": "string"}, "datatype": "string"}, "type": "statement", "id": "Q12089$555D5410-A402-4336-AAF8-0D85AFDB5678", "rank": "normal"}]}}