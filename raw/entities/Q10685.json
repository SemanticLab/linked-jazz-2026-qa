entity-type": "item", "numeric-id": 19, "id": "Q19"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q10685$9E560365-354F-4FAE-A99D-1E1CCE22E2F3", "rank": "normal"}], "P19": [{"mainsnak": {"snaktype": "value", "property": "P19", "hash": "45a5b65fc63206c0adbec7e1a60ce818e6f858fe", "datavalue": {"value": "That's right. He brought a baseball bat. We used to do this Satch and Josh thing, with the two pianos. And one night he came out on the stage and Norman said, \"and on the two pianos we have Oscar Peterson and Bill Basie, would you welcome them?\" I walked up from this end and Basie walked from the other. He had a baseball bat.", "type": "string"}, "datatype": "string"}, "type": "statement", "id": "Q10685$EF4A8C08-D6CF-46AB-8614-5D5D26D56238", "rank": "normal"}]}}