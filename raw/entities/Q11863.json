xt", "type": "string"}, "datatype": "url"}, "type": "statement", "id": "Q11863$B3FEDAC5-19BB-460A-A67D-42A55AFDEC75", "rank": "normal"}], "P21": [{"mainsnak": {"snaktype": "value", "property": "P21", "hash": "c31838b0c08fc7eadfcca526e12f31cb8eff122a", "datavalue": {"value": {"entity-type": "item", "numeric-id": 1388, "id": "Q1388"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q11863$D6E99875-690E-49AD-B0C1-F734E2F3F4C8", "rank": "normal"}, {"mainsnak": {"snaktype": "value", "property": "P21", "hash": "fcc7094f09fa45ee10e15233d7f860f873fbe6fb", "datavalue": {"value": {"entity-type": "item", "numeric-id": 97, "id": "Q97"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q11863$EBC0C599-3D37-4FFD-825F-00D13C0F3596", "rank": "normal"}, {"mainsnak": {"snaktype": "value", "property": "P21", "hash": "beb85a858bda70773f0fbaa529ea2be0fb695468", "datavalue": {"value": {"entity-type": "item", "numeric-id": 1410, "id": "Q1410"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q11863$C4A6C12B-BEB6-4EF3-B8DA-2AE3D1EA342F", "rank": "normal"}], "P22": [{"mainsnak": {"snaktype": "value", "property": "P22", "hash": "b7eaa6e89507dc6b54c3c4ba19db93a147ce8a6f", "datavalue": {"value": {"entity-type": "item", "numeric-id": 1386, "id": "Q1386"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q11863$81CA71A6-AD7D-426E-85A1-96A5034DAC76", "rank": "normal"}], "P23": [{"mainsnak": {"snaktype": "value", "property": "P23", "hash": "c7e1e1023400f659b211fe58b5adf4a1a7e6634e", "datavalue": {"value": {"entity-type": "item", "numeric-id": 1386, "id": "Q1386"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q11863$F74C1ED5-B651-4FBC-A74D-D49E30ED7149", "rank": "normal"}], "P19": [{"mainsnak": {"snaktype": "value", "property": "P19", "hash": "5a8f3cb3068d0ee25d69ed3503555f5c5cf48adf", "datavalue": {"value": "No. My name was changed. I let them change my name in 1954 when I came back from Honolulu. I was working at this joint called the Purple Onion -- no. The LeMadeline, the LeMadeline. It was a real joint, and I was offered a job at the Moulin Rouge through Eddie Beal, who was my coach. I was -- for the first time, I was studying with a coach. Eddie brought me Bob Russell, this great songwriter, a...", "type": "string"}, "datatype": "string"}, "type": "statement", "id": "Q11863$B545525F-99E7-49DC-873B-7977209325D9", "rank": "normal"}]}}