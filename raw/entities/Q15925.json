meric-id": 1803, "id": "Q1803"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q15925$97670EE6-324B-436E-B523-40CD462362BE", "rank": "normal"}, {"mainsnak": {"snaktype": "value", "property": "P21", "hash": "679c2e9f09900c510ea5a231901a0d50d6406bf5", "datavalue": {"value": {"entity-type": "item", "numeric-id": 704, "id": "Q704"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q15925$739117E7-74FF-4F43-A3D7-FAB4D4D739B1", "rank": "normal"}, {"mainsnak": {"snaktype": "value", "property": "P21", "hash": "653e89e66c47787b7f806376470907c0b06c28bd", "datavalue": {"value": {"entity-type": "item", "numeric-id": 490, "id": "Q490"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q15925$0CA8B95E-7A75-4BCE-B692-08F0780F1FEB", "rank": "normal"}, {"mainsnak": {"snaktype": "value", "property": "P21", "hash": "16f1f663904667148a541a7339580ca22645482a", "datavalue": {"value": {"entity-type": "item", "numeric-id": 1841, "id": "Q1841"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q15925$29D0B453-AB9D-4253-AE04-2A56AF54C5D1", "rank": "normal"}], "P22": [{"mainsnak": {"snaktype": "value", "property": "P22", "hash": "8e0abffddec0903ecca01af48d389b0fbf3384ab", "datavalue": {"value": {"entity-type": "item", "numeric-id": 1772, "id": "Q1772"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q15925$3AC91F1C-FA60-451E-ACFD-87CDB5EC8735", "rank": "normal"}], "P23": [{"mainsnak": {"snaktype": "value", "property": "P23", "hash": "25176b513f2f538153e5cdca588409932451f34f", "datavalue": {"value": {"entity-type": "item", "numeric-id": 1772, "id": "Q1772"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q15925$CB28E637-10D4-405F-83AA-AD05ED0A5353", "rank": "normal"}], "P19": [{"mainsnak": {"snaktype": "value", "property": "P19", "hash": "ca4877b5cf36d2a651848aff25866f2d46e27eff", "datavalue": {"value": "Like I told you, I had more love there, I met all of Klook's friends, and it was the world of August Wilson. If you ever saw Fences, that is the story. I never got to meet August Wilson, but I sure knew his work and where he had come from. Bull Ruther, a wonderful bass player, he lived in the projects. We'd have barbeques. It was a very happy time. Nobody had any money. When I came to New York ...", "type": "string"}, "datatype": "string"}, "type": "statement", "id": "Q15925$DA4B2AF5-1ADF-4CCE-9550-323526234A33", "rank": "normal"}]}}