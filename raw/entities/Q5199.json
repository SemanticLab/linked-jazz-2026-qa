il way into the late 40's. And the band that I worked with see had very, very, very top musicians in it. We had Edgar Sampson, the composer of [inaudible], well he was a friend of mine, see. And we had the young Benny Carter. We had the great Jimmy Harrison. We had Sidney DeParis on trumpet. We had Jabbo Smith, the ...", "type": "string"}, "datatype": "string"}, "type": "statement", "id": "Q5199$4662C509-B31E-4505-8A88-7088B508AC8C", "rank": "normal"}], "P20": [{"mainsnak": {"snaktype": "value", "property": "P20", "hash": "83f580c192b5c9b5d4665010709ddb1fae619cb4", "datavalue": {"value": "https://semlab.s3.amazonaws.com/texts/55e89b6f5d9f5c11f09479e94271ff64/25.txt", "type": "string"}, "datatype": "url"}, "type": "statement", "id": "Q5199$8DBF8036-7446-4748-9C56-614A486D1556", "rank": "normal"}], "P21": [{"mainsnak": {"snaktype": "value", "property": "P21", "hash": "d7d11e95f15c58fe8e8ffdaf8a6d5e0438310ea3", "datavalue": {"value": {"entity-type": "item", "numeric-id": 630, "id": "Q630"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q5199$C0EC8EBC-0536-4FA9-B2BC-ECDC2574C4C5", "rank": "normal"}, {"mainsnak": {"snaktype": "value", "property": "P21", "hash": "85dd028aef8c86cec7181aceec9d5b696fa208e3", "datavalue": {"value": {"entity-type": "item", "numeric-id": 644, "id": "Q644"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q5199$C2B00E55-C7B0-4A96-8656-61F07892A14F", "rank": "normal"}, {"mainsnak": {"snaktype": "value", "property": "P21", "hash": "fcc7094f09fa45ee10e15233d7f860f873fbe6fb", "datavalue": {"value": {"entity-type": "item", "numeric-id": 97, "id": "Q97"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q5199$E78E4457-DFEC-4DA8-8402-72130BB1919A", "rank": "normal"}, {"mainsnak": {"snaktype": "value", "property": "P21", "hash": "f44662a78c69afa19b69a47805ad4df373539269", "datavalue": {"value": {"entity-type": "item", "numeric-id": 64