ty-type": "item", "numeric-id": 85, "id": "Q85"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q16508$1F59C133-82AE-46BE-9F92-57DA10A27C17", "rank": "normal"}], "P19": [{"mainsnak": {"snaktype": "value", "property": "P19", "hash": "c606fae8c87eed9f966610b9cef157fc3437a014", "datavalue": {"value": "It wasn't, not really. I don't change from day to day. I am what I am, and that's whether I was working with Cannonball or Shearing or Ramsey [Lewis]. I love Gene Harris of the Three Sounds. We never got a chance to work together too often, but when we did, it was memorable. But I don't change up, just because it's different people. I'm still who I am and do what I do and was very blessed and f...", "type": "string"}, "datatype": "string"}, "type": "statement", "id": "Q16508$1C581A31-96AF-40BC-A5E6-14B2CE301258", "rank": "normal"}]}}