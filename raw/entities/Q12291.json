n kids aside for me, if I needed anything. Well, he was very charitable. Sometimes I'd bring kids in that didn't have shoes and he'd give them money to buy shoes or to buy clothing. Fletcher Burley had a big coat - this is funny - he had a big oversized coat made and he took me to gambling joints everywhere and he'd pu ...", "type": "string"}, "datatype": "string"}, "type": "statement", "id": "Q12291$4DF0FEDD-BCD7-4BFD-B6B0-DD85BC8A8F7E", "rank": "normal"}], "P20": [{"mainsnak": {"snaktype": "value", "property": "P20", "hash": "eb5b3cd16bb821e377ff349bb79386d40c590cb9", "datavalue": {"value": "https://semlab.s3.amazonaws.com/texts/7f2d6063335b48edf115ddc57d56bb92/103.txt", "type": "string"}, "datatype": "url"}, "type": "statement", "id": "Q12291$7D7FB185-0FC3-4E78-B74A-1E64743BE7AD", "rank": "normal"}], "P21": [{"mainsnak": {"snaktype": "value", "property": "P21", "hash": "f4c8c85acfc3d239e85f3c785aa3e2b46f03c242", "datavalue": {"value": {"entity-type": "item", "numeric-id": 1091, "id": "Q1091"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q12291$D712BA4A-353C-4792-9D5D-93F9FB3122B8", "rank": "normal"}], "P22": [{"mainsnak": {"snaktype": "value", "property": "P22", "hash": "e1689792b7d4d5d7c5e1807ce858e4cb68703f04", "datavalue": {"value": {"entity-type": "item", "numeric-id": 314, "id": "Q314"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q12291$2A13736F-B080-4F02-A849-CA0FB2CA2EAA", "rank": "normal"}], "P23": [{"mainsnak": {"snaktype": "value", "property": "P23", "hash": "62e862d79dc853f73db61dacc8750af62132638d", "datavalue": {"value": {"entity-type": "item", "numeric-id": 314, "id": "Q314"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q12291$03FCDEFA-2DF6-4530-819E-97058B2A3948", "rank": "normal"}]}}