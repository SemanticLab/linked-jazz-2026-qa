py so I said, \"I'm going to bed. \" doorbell and he came inside. He discovered that I was asleep - it was around 8 o'clock in the morning. I had a big, big twin bed, so when I woke up I saw something on the other bed and I screamed. He yelled too and ran out the door and ran in to the closet and the clothes fell on him. ...", "type": "string"}, "datatype": "string"}, "type": "statement", "id": "Q12658$775DC78E-4835-4929-BEFF-F466ACBC5DB5", "rank": "normal"}], "P20": [{"mainsnak": {"snaktype": "value", "property": "P20", "hash": "ca6bfc99f6d1ec62efd863daf98280f93b3edfa3", "datavalue": {"value": "https://semlab.s3.amazonaws.com/texts/7f2d6063335b48edf115ddc57d56bb92/470.txt", "type": "string"}, "datatype": "url"}, "type": "statement", "id": "Q12658$92207342-FA41-4E61-884C-C4926668B826", "rank": "normal"}], "P21": [{"mainsnak": {"snaktype": "value", "property": "P21", "hash": "199f80fd3f85af90bc3dcb77cad8e838c08ec897", "datavalue": {"value": {"entity-type": "item", "numeric-id": 71, "id": "Q71"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q12658$5133AB03-5E45-4A8F-8618-87DD838E7FCD", "rank": "normal"}], "P22": [{"mainsnak": {"snaktype": "value", "property": "P22", "hash": "e1689792b7d4d5d7c5e1807ce858e4cb68703f04", "datavalue": {"value": {"entity-type": "item", "numeric-id": 314, "id": "Q314"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q12658$6D911E45-E7A4-46FB-8FBF-6EFD54803FC3", "rank": "normal"}], "P23": [{"mainsnak": {"snaktype": "value", "property": "P23", "hash": "62e862d79dc853f73db61dacc8750af62132638d", "datavalue": {"value": {"entity-type": "item", "numeric-id": 314, "id": "Q314"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q12658$9A20E669-4D64-4B13-978A-8040236F161B", "rank": "normal"}]}}