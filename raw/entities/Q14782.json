txt", "type": "string"}, "datatype": "url"}, "type": "statement", "id": "Q14782$A45E0347-F6FA-42CA-B484-EDD7C662B67C", "rank": "normal"}], "P21": [{"mainsnak": {"snaktype": "value", "property": "P21", "hash": "f44662a78c69afa19b69a47805ad4df373539269", "datavalue": {"value": {"entity-type": "item", "numeric-id": 64, "id": "Q64"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q14782$39E61B97-E0A7-4F60-80F2-3A2BA59FC742", "rank": "normal"}, {"mainsnak": {"snaktype": "value", "property": "P21", "hash": "033bba94d2ee2ccb943991111d5eb28daf1061d7", "datavalue": {"value": {"entity-type": "item", "numeric-id": 101, "id": "Q101"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q14782$38F5A458-C2DD-4D01-9601-505250F19084", "rank": "normal"}, {"mainsnak": {"snaktype": "value", "property": "P21", "hash": "f65200c51c6cb8737a89efbb4a82ff02a8bdc2c7", "datavalue": {"value": {"entity-type": "item", "numeric-id": 199, "id": "Q199"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q14782$84E033C8-4745-4EAB-8857-4BC4CA4FB273", "rank": "normal"}], "P22": [{"mainsnak": {"snaktype": "value", "property": "P22", "hash": "189a81c60dd8299c93a290a01950038e445a5fa9", "datavalue": {"value": {"entity-type": "item", "numeric-id": 1671, "id": "Q1671"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q14782$796D7E28-4AEF-438C-B3D7-16C1FB9ACC4D", "rank": "normal"}], "P23": [{"mainsnak": {"snaktype": "value", "property": "P23", "hash": "8b3705af30b900679e0d4795a96a0c08573fa491", "datavalue": {"value": {"entity-type": "item", "numeric-id": 1671, "id": "Q1671"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q14782$1E28E001-4A6E-4546-9BC7-5B33F2EE734A", "rank": "normal"}], "P19": [{"mainsnak": {"snaktype": "value", "property": "P19", "hash": "839f313e477f1beec2a27c4053396f801e61bb3b", "datavalue": {"value": "Yeah. Why is this? That was the music that was in the house, and the first stuff that I heard I told you was the old recordings, not 1950's Louis Armstrong recordings, but Louis Armstrong on old 78's, Jelly Roll Morton on old 78's, Ellington on Vocalion or something, '30's, RCA, Columbia Records, that were actually coming out at that time, in the middle '30's.", "type": "string"}, "datatype": "string"}, "type": "statement", "id": "Q14782$462329FA-9B20-4C5C-9FDC-3BD0C810FD53", "rank": "normal"}]}}