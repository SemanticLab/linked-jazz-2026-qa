on College. We are very fortunate today to have with us Mona Hinton, who is the mother of all the jazz musicians in the U.S.A. She's married to Milt, and very much acts the part and is the perfect musician's wife. It's a joy indeed to have her here representing all those great musicians' wives. Mona, how are you today?", "type": "string"}, "datatype": "string"}, "type": "statement", "id": "Q13159$BB0AD722-2BF7-4CDC-B89B-1EBED061B562", "rank": "normal"}], "P20": [{"mainsnak": {"snaktype": "value", "property": "P20", "hash": "269e83d31192c00d0cf5349292b30c0ea76f8d5d", "datavalue": {"value": "https://semlab.s3.amazonaws.com/texts/ee79cef9cdce4d68a4d3614f19ef7a7f/0.txt", "type": "string"}, "datatype": "url"}, "type": "statement", "id": "Q13159$F13D25DB-5C12-4284-9D9D-412BE212EAB3", "rank": "normal"}], "P21": [{"mainsnak": {"snaktype": "value", "property": "P21", "hash": "0b3595e8f57aaa993c1632776cf8ecf23951a211", "datavalue": {"value": {"entity-type": "item", "numeric-id": 60, "id": "Q60"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q13159$E5839EAF-B377-4599-9161-CD02315085A9", "rank": "normal"}], "P22": [{"mainsnak": {"snaktype": "value", "property": "P22", "hash": "e27b4f098684c31b4e525045be8321811b6fc3b3", "datavalue": {"value": {"entity-type": "item", "numeric-id": 732, "id": "Q732"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q13159$0C2613D6-3C75-4AC3-95CA-CCE691CDDE4B", "rank": "normal"}], "P23": [{"mainsnak": {"snaktype": "value", "property": "P23", "hash": "e015ec8cb200e4a97aecff1d9681b54b88000876", "datavalue": {"value": {"entity-type": "item", "numeric-id": 834, "id": "Q834"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q13159$230523C4-CB0C-4804-89E4-C66B0925B80D", "rank": "normal"}]}}