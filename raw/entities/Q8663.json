pe": "string"}, "datatype": "url"}, "type": "statement", "id": "Q8663$E40CECDD-70B7-433B-9119-898636B6E121", "rank": "normal"}], "P21": [{"mainsnak": {"snaktype": "value", "property": "P21", "hash": "1fcbe008b7e68d0ae3082395ec7e4aa7b7a86fe0", "datavalue": {"value": {"entity-type": "item", "numeric-id": 72, "id": "Q72"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q8663$76C1AB1B-C54D-4713-AC62-65D23C04B31A", "rank": "normal"}], "P22": [{"mainsnak": {"snaktype": "value", "property": "P22", "hash": "a6ad148705337cdabc4b8db6cbda0253c1618c2e", "datavalue": {"value": {"entity-type": "item", "numeric-id": 46, "id": "Q46"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q8663$108B8AF3-1CB7-491F-BBD2-8D31AC894FA2", "rank": "normal"}], "P23": [{"mainsnak": {"snaktype": "value", "property": "P23", "hash": "8a6e92ebe316a972c70c2d7b0f6035cba8ab24dd", "datavalue": {"value": {"entity-type": "item", "numeric-id": 46, "id": "Q46"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q8663$B1861ADF-7057-46AE-9CCC-4A84F8859C54", "rank": "normal"}], "P19": [{"mainsnak": {"snaktype": "value", "property": "P19", "hash": "3dc1fab65b9002006bc1282a44e281a1f221a53b", "datavalue": {"value": "No, no. You do what you do. I sing. And if I feel like I want to sing something I do it. I used to have some problems with Mr. Basie sometimes. I would ask, I\u2019d say \u201cHey, Bas\u2019, I\u2019d like to get an arrangement on\u201d such and such a song. And he\u2019d say \u201coh, you don\u2019t need that thing. Sing the thing you\u2019ve been singing.\u201d You know. If you let people, even those closest to you \u2014 and he was very close to...", "type": "string"}, "datatype": "string"}, "type": "statement", "id": "Q8663$00B8BCB3-89FF-48A7-AC0D-DADEF73F0F0D", "rank": "normal"}]}}