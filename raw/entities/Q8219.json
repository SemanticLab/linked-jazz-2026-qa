nths older than I. July 18, 1923 I took my first violin lesson. My mother sent me to the west side to the Jane Ellis Hull House, every Saturday, where kids could get music lessons for twenty-five cents. And Benny Goodman was right there. There was nine in his family. We were, back in 1923, we were taking music lesso ...", "type": "string"}, "datatype": "string"}, "type": "statement", "id": "Q8219$693C05DD-BE07-492E-81CF-163677CFC464", "rank": "normal"}], "P20": [{"mainsnak": {"snaktype": "value", "property": "P20", "hash": "dd3788b19fe0dbc90728b46621b36b37acd66908", "datavalue": {"value": "https://semlab.s3.amazonaws.com/texts/65442cf9b5d0c92de6785c23f3c846fd/207.txt", "type": "string"}, "datatype": "url"}, "type": "statement", "id": "Q8219$385E3A45-0566-43D2-906F-E351DE544E31", "rank": "normal"}], "P21": [{"mainsnak": {"snaktype": "value", "property": "P21", "hash": "84e2956202984c90df58f73b8cec6381db1a1c84", "datavalue": {"value": {"entity-type": "item", "numeric-id": 785, "id": "Q785"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q8219$35878C79-5E46-4F00-8A00-62DD7F18DDDD", "rank": "normal"}, {"mainsnak": {"snaktype": "value", "property": "P21", "hash": "33eabf49c5b67bcf22e11ff387a4035cb991d4a8", "datavalue": {"value": {"entity-type": "item", "numeric-id": 50, "id": "Q50"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q8219$C33CFF15-0C66-492B-B93E-0EB97BEFFA55", "rank": "normal"}, {"mainsnak": {"snaktype": "value", "property": "P21", "hash": "4f8d24152b05e221b048612eef6ae2cf9d8084d5", "datavalue": {"value": {"entity-type": "item", "numeric-id": 786, "id": "Q786"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q8219$A17F18DA-62D2-47D2-9ED4-CCB711647CBA", "rank": "normal"}], "P22": [{"mainsnak": {"snaktype": "value", "property": "P22", "hash": "292a1cbaad6da1693efca67f0db779a7caa32685", "datavalue": {"value": {"entity-type": "item", "nume