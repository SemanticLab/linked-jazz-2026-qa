ype": "item", "numeric-id": 1671, "id": "Q1671"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q14812$E2FAC6FD-6806-4914-A2DD-C383CB7B4849", "rank": "normal"}], "P19": [{"mainsnak": {"snaktype": "value", "property": "P19", "hash": "b16f7b1d0922f2a4ad4381af6b9f3810791ffdff", "datavalue": {"value": "It was inevitable. And I was glad to see it finally get to that point you know. When I was at Yale University there was nothing there. Then after I left I saw that Gunther Schuller had come in there and he was teaching and I said well things are hopeful. And then he brought up Diz and Max Roach and the Duke and gave them all honorary degrees. I said now it's really looking good, I think I'll go...", "type": "string"}, "datatype": "string"}, "type": "statement", "id": "Q14812$48DC0492-3342-48E0-991A-F7F1B7907641", "rank": "normal"}]}}