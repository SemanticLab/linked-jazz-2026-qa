2.txt", "type": "string"}, "datatype": "url"}, "type": "statement", "id": "Q18545$9C6CC15D-CF67-47FD-8BD9-894DAD7EE39F", "rank": "normal"}], "P21": [{"mainsnak": {"snaktype": "value", "property": "P21", "hash": "a873fc09a332ac699a116dc05beaf9a9cd18c79a", "datavalue": {"value": {"entity-type": "item", "numeric-id": 90, "id": "Q90"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q18545$46F4EEAE-C9E2-4E25-A948-2FC01F917591", "rank": "normal"}], "P22": [{"mainsnak": {"snaktype": "value", "property": "P22", "hash": "0c21fd01447f9981d6febefb33347c3f45c29f90", "datavalue": {"value": {"entity-type": "item", "numeric-id": 892, "id": "Q892"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q18545$4276AA97-B64D-46D6-A701-AD5F81A2B95A", "rank": "normal"}], "P23": [{"mainsnak": {"snaktype": "value", "property": "P23", "hash": "0bc520a8d862f0943264e44b5a48079bd8778019", "datavalue": {"value": {"entity-type": "item", "numeric-id": 892, "id": "Q892"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q18545$30EE3C83-086D-43B1-B769-8C6FADAFB977", "rank": "normal"}], "P19": [{"mainsnak": {"snaktype": "value", "property": "P19", "hash": "c3886f1c2d29cb5d5a3fb90a980133b8fb46c3fa", "datavalue": {"value": "I like to think so, yes, yes. Somebody tried to say, somebody said that Mingus, uh ... put the lid of the piano over my hand. He never did that. If he did that I probably wouldn't have a hand [laughs]. You know, people come up with all kinds of stupid lies. He wasn't ... but he was very nasty to other players. You know, sometimes if he didn't like [something or someone], he'd kick the drums and...", "type": "string"}, "datatype": "string"}, "type": "statement", "id": "Q18545$A4377ACF-63F3-4AAF-84F1-C9E0ED98EF8E", "rank": "normal"}]}}