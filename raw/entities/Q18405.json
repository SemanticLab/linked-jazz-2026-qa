2.txt", "type": "string"}, "datatype": "url"}, "type": "statement", "id": "Q18405$2BBDBEC7-2F38-4F27-A133-B6142EE47C7B", "rank": "normal"}], "P21": [{"mainsnak": {"snaktype": "value", "property": "P21", "hash": "db3e4ac07b132f776bfd997feda8610bc69d0f54", "datavalue": {"value": {"entity-type": "item", "numeric-id": 41, "id": "Q41"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q18405$FAE875D9-9883-4AA0-A78B-8696FB4B3A43", "rank": "normal"}, {"mainsnak": {"snaktype": "value", "property": "P21", "hash": "c4ec5cac3e4b768b84e9c7a139ba112f8d947939", "datavalue": {"value": {"entity-type": "item", "numeric-id": 47, "id": "Q47"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q18405$C49D8704-C3EE-496D-A3D6-B39F5C84130A", "rank": "normal"}, {"mainsnak": {"snaktype": "value", "property": "P21", "hash": "d3a867a64d92a8bc2f55c9bd200fb5a53717b5c4", "datavalue": {"value": {"entity-type": "item", "numeric-id": 33, "id": "Q33"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q18405$139F9676-2C6F-41EB-B84B-C2B8409577B1", "rank": "normal"}], "P22": [{"mainsnak": {"snaktype": "value", "property": "P22", "hash": "0c21fd01447f9981d6febefb33347c3f45c29f90", "datavalue": {"value": {"entity-type": "item", "numeric-id": 892, "id": "Q892"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q18405$2D915765-D6B5-4FAE-92B6-48BAE7355D98", "rank": "normal"}], "P23": [{"mainsnak": {"snaktype": "value", "property": "P23", "hash": "0bc520a8d862f0943264e44b5a48079bd8778019", "datavalue": {"value": {"entity-type": "item", "numeric-id": 892, "id": "Q892"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q18405$9FDCA536-E668-4731-8D65-0DCC54D76AE2", "rank": "normal"}], "P19": [{"mainsnak": {"snaktype": "value", "property": "P19", "hash": "3b21cc5288f0354ce7ff91509f10471258f7f18f", "datavalue": {"value": "Oh yes. Sometimes it was Miles' group--only it was, John Coltrane was there after Sonny Rollins. That ... the old Birdland's band room, backstage, it was like what we call ... Japanese have a saying, \"a bed for an eel.\" In other words, long and narrow. And that's where the backstage was. But when it was Miles' group, they all played very long solos, except Miles didn't play long solos. But ... ...", "type": "string"}, "datatype": "string"}, "type": "statement", "id": "Q18405$A1D78BB2-7206-497A-9DFC-419F90A7AA92", "rank": "normal"}]}}