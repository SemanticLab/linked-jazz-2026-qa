6.txt", "type": "string"}, "datatype": "url"}, "type": "statement", "id": "Q18629$1E1C5086-36B2-4B7B-B53A-31845011BFD0", "rank": "normal"}], "P21": [{"mainsnak": {"snaktype": "value", "property": "P21", "hash": "f44662a78c69afa19b69a47805ad4df373539269", "datavalue": {"value": {"entity-type": "item", "numeric-id": 64, "id": "Q64"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q18629$962E564A-B909-442E-887E-8E49F0A7C5D7", "rank": "normal"}], "P22": [{"mainsnak": {"snaktype": "value", "property": "P22", "hash": "0c21fd01447f9981d6febefb33347c3f45c29f90", "datavalue": {"value": {"entity-type": "item", "numeric-id": 892, "id": "Q892"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q18629$4773EAB9-8931-4F93-B135-04C3F061BC29", "rank": "normal"}], "P23": [{"mainsnak": {"snaktype": "value", "property": "P23", "hash": "0bc520a8d862f0943264e44b5a48079bd8778019", "datavalue": {"value": {"entity-type": "item", "numeric-id": 892, "id": "Q892"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q18629$EECE1DAD-040C-4296-BBAC-98CF4A5CFD51", "rank": "normal"}], "P19": [{"mainsnak": {"snaktype": "value", "property": "P19", "hash": "1dde3dc2b4126da394d8fb9898972a27ceace245", "datavalue": {"value": "And I thought, \"I wish Duke were alive. I wonder what he would say?\" I was thinking about that. Duke was always very uh, ... grandeur. He came a couple of times to the [Berklee] school when I was at school, and I had a terrible cold. And he would say [deep, elegant voice], \"Oh, poor child. My dear, I have to send you to my doctor.\"", "type": "string"}, "datatype": "string"}, "type": "statement", "id": "Q18629$5C876042-DA59-4703-939E-944F21C61D7A", "rank": "normal"}]}}