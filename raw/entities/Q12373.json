ice. I had a close shave a couple of times playing for parties, young boys, their parents had gone to Europe, and I just left. They were up- stairs getting drunk and I ran out and left. I wouldn't tell my stepfather because he would have gone back and killed everybody, because he was very mean about things like that.", "type": "string"}, "datatype": "string"}, "type": "statement", "id": "Q12373$D7C7663B-B8E1-4684-B0E9-7D86E6C8D0C2", "rank": "normal"}], "P20": [{"mainsnak": {"snaktype": "value", "property": "P20", "hash": "dd0df5ccb00db60836916261444e70348e660766", "datavalue": {"value": "https://semlab.s3.amazonaws.com/texts/7f2d6063335b48edf115ddc57d56bb92/185.txt", "type": "string"}, "datatype": "url"}, "type": "statement", "id": "Q12373$785E5AB5-9E54-4C1C-B1D4-8BD16EC2E648", "rank": "normal"}], "P21": [{"mainsnak": {"snaktype": "value", "property": "P21", "hash": "ea28b4e9760c1b4a4d09e62f73dca4dfcea52c8f", "datavalue": {"value": {"entity-type": "item", "numeric-id": 1099, "id": "Q1099"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q12373$23CCF5F1-63FC-4169-BF8F-8360BD7FBC17", "rank": "normal"}], "P22": [{"mainsnak": {"snaktype": "value", "property": "P22", "hash": "e1689792b7d4d5d7c5e1807ce858e4cb68703f04", "datavalue": {"value": {"entity-type": "item", "numeric-id": 314, "id": "Q314"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q12373$89F5A75B-092F-4492-9859-0976540DACFF", "rank": "normal"}], "P23": [{"mainsnak": {"snaktype": "value", "property": "P23", "hash": "62e862d79dc853f73db61dacc8750af62132638d", "datavalue": {"value": {"entity-type": "item", "numeric-id": 314, "id": "Q314"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q12373$E89E072F-53B2-4F24-B985-9A5CE7461C41", "rank": "normal"}]}}