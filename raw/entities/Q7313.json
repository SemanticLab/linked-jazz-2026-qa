{"type": "item", "id": "Q7313", "labels": {"en": {"language": "en", "value": "Dave Brubeck Smithsonian Interview Block 402"}}, "descriptions": {}, "aliases": {}, "claims": {"P1": [{"mainsnak": {"snaktype": "value", "property": "P1", "hash": "e173334c8eb6ae838e6c2b776160130a08e273ac", "datavalue": {"value": {"entity-type": "item", "numeric-id": 2013, "id": "Q2013"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q7313$B2700B84-C01A-479D-B40F-AC3171D49B2F", "rank": "normal"}], "P11": [{"mainsnak": {"snaktype": "value", "property": "P11", "hash": "2470dc848bd2d49979b4f87a72694295f068875b", "datavalue": {"value": {"entity-type": "item", "numeric-id": 21217, "id": "Q21217"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q7313$76FA3644-14DE-4A7F-8ECE-100E31DA7B8F", "rank": "normal"}], "P24": [{"mainsnak": {"snaktype": "value", "property": "P24", "hash": "5dbc31d576b3f7eab4bf11464c981446026ef308", "datavalue": {"value": {"entity-type": "item", "numeric-id": 2055, "id": "Q2055"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q7313$B7405ACF-AA50-4AD1-BCCF-04733930C595", "rank": "normal"}], "P17": [{"mainsnak": {"snaktype": "value", "property": "P17", "hash": "8aa536b2c240b260b1e80bd113d2a7a9f8a152eb", "datavalue": {"value": "402", "type": "string"}, "datatype": "string"}, "type": "statement", "id": "Q7313$387035C9-3474-4B2C-8F19-3D4A3EA2A7F5", "rank": "normal"}], "P18": [{"mainsnak": {"snaktype": "value", "property": "P18", "hash": "d5bd5231177fee85c158518d4d1d90425ce48b99", "datavalue": {"value": "A", "type": "string"}, "datatype": "string"}, "type": "statement", "id": "Q7313$BE201321-2EA0-426C-AFF6-539AFEDA88D5", "rank": "normal"}], "P19": [{"mainsnak": {"snaktype": "value", "property": "P19", "hash": "3d7fa3bf38e6aac96637b4acbce7fedf643dcd2d", "datavalue": {"value": "So I contacted Jeff Levenson. We sent him a tape. The music started to come to me a week before the festival. This was in August of 2001. I looked at this, and the very first thing I saw was a Bill Smith arrangement of What is This Thing Called Love? in E-major. Bill is a very creative person, but he's also extremely practical and lazy when it comes to solos. He's not going to write a solo for ...", "type": "string"}, "datatype": "string"}, "type": "statement", "id": "Q7313$305B675C-8A20-44FC-8940-B5B40EBEC875", "rank": "normal"}], "P20": [{"mainsnak": {"snaktype": "value", "property": "P20", "hash": "ae025d923a521562ca83a4bd0eb8e442ab45e7bf", "datavalue": {"value": "https://semlab.s3.amazonaws.com/texts/28c7e27b63a73c4426771be57b736187/402.txt", "type": "string"}, "datatype": "url"}, "type": "statement", "id": "Q7313$80BF669D-1314-47D0-9763-32D753785787", "rank": "normal"}], "P21": [{"mainsnak": {"snaktype": "value", "property": "P21", "hash": "ac9bc76d44ed893e3e64c79a967be5a84439151a", "datavalue": {"value": {"entity-type": "item", "numeric-id": 558, "id": "Q558"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q7313$2CC4949B-C95B-46B0-A8F3-D95516D83FDC", "rank": "normal"}], "P22": [{"mainsnak": {"snaktype": "value", "property": "P22", "hash": "ffc035cdb5d590554228b3ded2800686af011a07", "datavalue": {"value": {"entity-type": "item", "numeric-id": 311, "id": "Q311"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q7313$EA0D6865-DB0C-40D5-B221-6B79AE2EA9A0", "rank": "normal"}], "P23": [{"mainsnak": {"snaktype": "value", "property": "P23", "hash": "ac85719cce349b99915cb2dff8baba85f373b740", "datavalue": {"value": {"entity-type": "item", "numeric-id": 517, "id": "Q517"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q7313$186BB64F-9F4B-4EF2-AEAF-55FA8C469BDD", "rank": "normal"}]}}