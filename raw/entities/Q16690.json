 thing. Just recently, I was honored by The Brotherhood Crusade. The Brotherhood Crusade, I have been with and known since they started, and I did one of the first fundraisers that they ever had. They gave me - they had an evening honoring Nancy Wilson a few weeks ago that was the most magnificent thing I've ever seen ...", "type": "string"}, "datatype": "string"}, "type": "statement", "id": "Q16690$C3CB9B21-F455-4D50-B283-A8C01F647FBA", "rank": "normal"}], "P20": [{"mainsnak": {"snaktype": "value", "property": "P20", "hash": "9e8a0e2d4ae8a368bc3bbd0d55da986556881195", "datavalue": {"value": "https://semlab.s3.amazonaws.com/texts/c4c4cecae7d067daa546001e6c34dd66/515.txt", "type": "string"}, "datatype": "url"}, "type": "statement", "id": "Q16690$EDF91EA9-71B9-475F-88D0-41F5307BBFE4", "rank": "normal"}], "P21": [{"mainsnak": {"snaktype": "value", "property": "P21", "hash": "057a09a160e6fa3a8702a1b5742d5397b9ed93e4", "datavalue": {"value": {"entity-type": "item", "numeric-id": 1883, "id": "Q1883"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q16690$C9128BC1-02CF-4CC6-994E-795E72C53451", "rank": "normal"}], "P22": [{"mainsnak": {"snaktype": "value", "property": "P22", "hash": "4cf4eb57c9c41abe5fb05373f7a66b52832e1f26", "datavalue": {"value": {"entity-type": "item", "numeric-id": 85, "id": "Q85"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q16690$D43BA7CA-2ECC-4F88-A3A0-D415099CA6CC", "rank": "normal"}], "P23": [{"mainsnak": {"snaktype": "value", "property": "P23", "hash": "56a36472bf138ad657bcd00b39a227efdeb13c86", "datavalue": {"value": {"entity-type": "item", "numeric-id": 85, "id": "Q85"}, "type": "wikibase-entityid"}, "datatype": "wikibase-item"}, "type": "statement", "id": "Q16690$EE57CB7B-198D-44B8-8965-B59681DF867C", "rank": "normal"}]}}